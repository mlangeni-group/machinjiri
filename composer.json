{
  "name": "machinjiri/framework",
  "description": "Machinjiri is a lightweight, flexible PHP framework for rapid web development.",
  "type": "library",
  "license": "proprietary",
  "version": "2.3.0",
  "authors": [
    {
      "name": "Precious Lyson",
      "email": "precious.lyson@gmail.com",
      "role": "Developer"
    },
    {
      "name": "Mlangeni Group",
      "email": "mlangenigroupqm@gmail.com",
      "role": "Company"
    }
  ],
  "require": {
    "php": "^8.4",
    "phpmailer/phpmailer": "^7.1",
    "symfony/console": "^5.3",
    "symfony/filesystem": "^5.3",
    "symfony/process": "^5.3",
    "africastalking/africastalking": "^3.0.2"
  },
  "require-dev": {
    "machinjiri/advocate":"^1.0",
    "phpunit/phpunit": "^10.0",
    "mockery/mockery": "^1.5",
    "fakerphp/faker": "^1.20",
    "brianium/paratest": "*"
  },
  "suggest": {
    "predis/predis" : "^3.3.0",
    "dragonmantank/cron-expression": "^3.6.0"
  },
  "autoload": {
    "psr-4": {
      "Mlangeni\\Machinjiri\\": "src/Machinjiri/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Mlangeni\\Machinjiri\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "keywords": ["mlangeni", "machinjiri", "preciouslyson", "framework", "php", "lightweight", "web", "development"]
}
